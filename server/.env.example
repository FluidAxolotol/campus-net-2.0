# ============================================================
# 校内网 2.0 后端环境变量示例
# 复制成 server/.env 后按本机情况修改；.env 不进 Git。
# ============================================================

# development | production | test
NODE_ENV=development

# Node 只监听本机；公网入口是 Nginx
PORT=3100
PUBLIC_ORIGIN=http://localhost:8088

# MySQL 8
DB_HOST=127.0.0.1
DB_PORT=3308
DB_NAME=campus2
DB_USER=campus2
DB_PASSWORD=campus2_pass

# 两套会话密钥，必须不同。生产环境必须替换成随机长字符串。
SESSION_SECRET=dev-user-session-secret-change-me-please-1234567890
ADMIN_SESSION_SECRET=dev-admin-session-secret-change-me-please-0987654321

# AES-256-GCM 密钥：64 位十六进制（32 字节）
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 首次创建管理员时使用
ADMIN_USERNAME=campusadmin
ADMIN_DISPLAY_NAME=平台管理员
ADMIN_DEFAULT_PASSWORD=Admin@2026

# 上传目录（相对 server/ 解析），必须在 web/ 之外
UPLOAD_DIR=./uploads
# 本地 false：Express 直接发文件；生产 true：交给 Nginx 的 X-Accel-Redirect
USE_X_ACCEL=false

# 仅本地/测试可设为 1；生产必须为 0 或不设
RATE_LIMIT_DISABLED=1

# 演示种子用户密码（seed 脚本使用）
SEED_USER_PASSWORD=Student@2026
